# Loaded by `vite build --mode wasm` (npm run build:wasm).
#
# Forces the Studio bundle to boot WasmApiClient on every path - used
# for the standalone WASM deployment at traverse.truespar.com. The
# default `npm run build` skips this file, so the server-embedded
# bundle continues to default to HttpApiClient.
VITE_TRAVERSE_WASM=1
