<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NuGet metadata the packages share; each one sets IsPackable, PackageId, Description and PackageTags -->
  <PropertyGroup>
    <Version>0.9.1</Version>
    <Authors>Truespar</Authors>
    <Company>The Intelligence Company AB (publ)</Company>
    <Copyright>Copyright 2026 The Intelligence Company AB (publ)</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://truespar.com/traverse/docs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/truespar/traverse</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/truespar/traverse/blob/main/RELEASE_NOTES.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- the licence texts in every package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE-MIT;$(MSBuildThisFileDirectory)../LICENSE-APACHE"
          Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
