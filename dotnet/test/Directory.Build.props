<Project>
  <Import Project="../Directory.Build.props" />

  <!-- xUnit.net v3 test apps, run by Microsoft.Testing.Platform (see global.json) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
